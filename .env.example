# ===========================================
# AAC Middleware Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ----- Pipedrive -----
PIPEDRIVE_API_KEY=
PIPEDRIVE_COMPANY_DOMAIN=yourcompany.pipedrive.com
# The user ID of the "system" account used for API operations
# Critical for loop prevention - find this in Pipedrive Settings > Users
PIPEDRIVE_SYSTEM_USER_ID=

# ----- Quo (OpenPhone) -----
QUO_API_KEY=
# You'll get this after creating the webhook in Quo dashboard
QUO_WEBHOOK_SECRET=
# Phone number for sending outbound messages (your Quo number, E.164 format)
QUO_PHONE_NUMBER=+16176681677

# ----- Google Ads -----
# Secret key configured in Google Ads webhook settings
GOOGLE_ADS_WEBHOOK_KEY=

# ----- Gemini AI -----
# API key for entity extraction (Module 1.3)
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ----- Notifications -----
# Phone number to receive lead alerts (E.164 format)
ALERT_PHONE_NUMBER=+16176681677

# ----- Upstash Redis -----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ----- Environment -----
# Set to 'development' locally, 'production' in Vercel
NODE_ENV=development
