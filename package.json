{
  "name": "aac-middleware",
  "version": "0.1.0",
  "private": true,
  "description": "Lightweight middleware for business system integrations",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src/**/*.ts",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "campaign:start": "npx tsx scripts/run-campaign.ts",
    "campaign:stats": "npx tsx -e \"const { getCampaign } = require('./src/lib/redis.js'); getCampaign(process.argv[2]).then(c => console.log(JSON.stringify(c, null, 2)))\""
  },
  "dependencies": {
    "@upstash/qstash": "^2.8.4",
    "@upstash/redis": "^1.28.0",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.2.3",
    "libphonenumber-js": "^1.10.54",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^20.10.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^3.0.0",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
