{
  "name": "aac-middleware",
  "version": "0.1.0",
  "private": true,
  "description": "Lightweight middleware for business system integrations",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src/**/*.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "campaign:start": "npx tsx scripts/run-campaign.ts",
    "campaign:stats": "npx tsx -e \"const { getCampaign } = require('./src/lib/redis.js'); getCampaign(process.argv[2]).then(c => console.log(JSON.stringify(c, null, 2)))\"",
    "prepare": "husky",
    "doctor": "python3 harness/doctor.py",
    "doctor:diagnose": "python3 harness/doctor.py diagnose",
    "doctor:stabilize": "python3 harness/doctor.py stabilize",
    "doctor:baseline": "python3 harness/doctor.py baseline",
    "doctor:fixtures": "python3 harness/doctor.py fixtures",
    "doctor:qa": "python3 harness/doctor.py qa",
    "doctor:solidify": "python3 harness/doctor.py solidify",
    "spec": "python3 harness/architect.py",
    "spec:new": "python3 harness/architect.py new",
    "spec:resume": "python3 harness/architect.py resume",
    "spec:audit": "python3 harness/architect.py audit",
    "agent:loop": "python3 harness/coding/loop.py"
  },
  "dependencies": {
    "@upstash/qstash": "^2.8.4",
    "@upstash/redis": "^1.28.0",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.2.3",
    "libphonenumber-js": "^1.10.54",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^20.10.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^3.0.0",
    "autoprefixer": "^10.4.23",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0",
    "vite-tsconfig-paths": "^6.0.4",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "vitest related --run"
    ]
  }
}
